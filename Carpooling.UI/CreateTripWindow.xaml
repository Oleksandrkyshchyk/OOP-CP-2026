<Window x:Class="Carpooling.UI.CreateTripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Створення нової поїздки" Height="645" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="text" 
                                   Text="{TemplateBinding Content}" 
                                   Background="Transparent"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="text" Property="Foreground" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="15" Padding="30" Margin="20"
                VerticalAlignment="Center" MaxWidth="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#CCCCCC" Direction="270" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Нова поїздка" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#333333"/>

                <TextBlock Text="Звідки (Місто)" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFrom" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Куди (Місто)" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTo" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Дата та час відправлення" Foreground="Gray" Margin="0,0,0,5"/>
                <DatePicker x:Name="datePicker" Height="35" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTime" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" 
                         Text="12:00" ToolTip="Формат ГГ:ХХ"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="К-сть місць" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSeats" Height="35" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Ціна (грн)" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPrice" Height="35" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Background="#F9F9F9" CornerRadius="5" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="lblCarInfo" Text="Авто: Tesla Model 3 (AA 1234 BB)" 
                                   FontSize="12" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="btnCreate" Content="Опублікувати поїздку" Height="45" 
                        Background="#007ACC" Foreground="White" FontWeight="Bold" 
                        Click="btnCreate_Click" Margin="0,0,0,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#005A9E"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#E1E1E1"/>
                                    <Setter TargetName="content" Property="TextBlock.Foreground" Value="#888888"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="btnCancel" 
                        Content="Скасувати" 
                        Style="{StaticResource LinkButtonStyle}"
                        Margin="0,5,0,0"
                        Click="btnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>