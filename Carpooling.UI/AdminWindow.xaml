<Window x:Class="Carpooling.UI.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель адміністратора - FocusFlow" Height="753" Width="1050"
        WindowStartupLocation="CenterScreen" Background="#F4F7F9">

    <Window.Resources>
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="text" Text="{TemplateBinding Content}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
                <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Ellipse Fill="#E3F2FD"/>
                    <Viewbox Width="50" Height="50" Stretch="Uniform">
                        <Path Fill="#1976D2" Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                    </Viewbox>
                </Grid>

                <TextBlock Text="Admin Panel" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2D3436" Margin="0,0,0,5"/>
                <TextBlock Text="Системний доступ" FontSize="14" Foreground="#1976D2" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <Separator Background="#F1F1F1" Margin="0,10"/>

                <TextBlock Text="Всього користувачів:" FontSize="12" Foreground="#636E72" Margin="0,10,0,0"/>
                <TextBlock x:Name="txtStatUsers" Text="0" Style="{StaticResource StatValueStyle}"/>

                <TextBlock Text="Активних поїздок:" FontSize="12" Foreground="#636E72" Margin="0,0,0,0"/>
                <TextBlock x:Name="txtStatTrips" Text="0" Style="{StaticResource StatValueStyle}"/>

                <TextBlock Text="Оборот системи:" FontSize="12" Foreground="#636E72" Margin="0,0,0,0"/>
                <TextBlock x:Name="txtStatMoney" Text="0 грн" Style="{StaticResource StatValueStyle}" Foreground="#28A745"/>

                <StackPanel Margin="0,20,0,0">
                    <Button x:Name="btnViewUsers" Content="Керувати користувачами" Height="40" Margin="0,0,0,10" Style="{StaticResource RoundButtonStyle}" Click="btnViewUsers_Click"/>
                    <Button x:Name="btnViewTrips" Content="Модерація поїздок" Height="40" Margin="0,0,0,10" Style="{StaticResource RoundButtonStyle}" Click="btnViewTrips_Click"/>
                </StackPanel>

                <Button x:Name="btnLogout" Content="Вийти з акаунту" Margin="0,20,0,10" Height="40" Style="{StaticResource RoundButtonStyle}" Foreground="#D63031" Click="btnLogout_Click"/>
                <Button x:Name="btnBack" Content="Назад на головну" Style="{StaticResource LinkButtonStyle}" Click="btnBack_Click" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,0,0,0">
            <StackPanel x:Name="panelUsers" Visibility="Visible">
                <TextBlock Text="Список користувачів системи" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#2D3436"/>
                <Border Background="White" CornerRadius="15" Padding="15">
                    <DataGrid x:Name="dgUsers" Height="400" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логін" Binding="{Binding Login}" Width="100"/>
                            <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="90"/>
                            <DataGridTextColumn Header="Прізвище та Ім'я" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="80"/>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Пароль" Style="{StaticResource LinkButtonStyle}" 
                                                    Foreground="#1976D2" Click="btnChangePassword_Click" Tag="{Binding}" Margin="0,0,10,0"/>
                                            <Button Content="Видалити" Style="{StaticResource LinkButtonStyle}" 
                                                    Foreground="#D63031" Click="btnDeleteUser_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Content="Зберегти в JSON" Style="{StaticResource RoundButtonStyle}" Margin="0,0,10,0" Height="40" Click="btnSaveJson_Click"/>
                    <Button Content="Завантажити з JSON" Style="{StaticResource RoundButtonStyle}" Height="40" Click="btnLoadJson_Click"/>
                </UniformGrid>
            </StackPanel>

            <StackPanel x:Name="panelTrips" Visibility="Collapsed">
                <TextBlock Text="Всі оголошення про поїздки" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="#2D3436"/>
                <Border Background="White" CornerRadius="15" Padding="15">
                    <DataGrid x:Name="dgTrips" Height="400" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Звідки" Binding="{Binding DepartureCity}" Width="*"/>
                            <DataGridTextColumn Header="Куди" Binding="{Binding ArrivalCity}" Width="*"/>
                            <DataGridTextColumn Header="Час" Binding="{Binding DepartureTime, StringFormat='{}{0:dd.MM HH:mm}'}" Width="100"/>
                            <DataGridTextColumn Header="Водій" Binding="{Binding DriverLogin}" Width="100"/>
                            <DataGridTextColumn Header="Ціна" Binding="{Binding Price}" Width="60"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Скасувати" Style="{StaticResource LinkButtonStyle}" 
                                                    Foreground="#E67E22" Click="btnAdminCancelTrip_Click" Tag="{Binding}" Margin="0,0,10,0"/>
                                            <Button Content="Видалити" Style="{StaticResource LinkButtonStyle}" 
                                                    Foreground="#D63031" Click="btnAdminFullDeleteTrip_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Content="Зберегти в JSON" Style="{StaticResource RoundButtonStyle}" Margin="0,0,10,0" Height="40" Click="btnSaveJson_Click"/>
                    <Button Content="Завантажити з JSON" Style="{StaticResource RoundButtonStyle}" Height="40" Click="btnLoadJson_Click"/>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>