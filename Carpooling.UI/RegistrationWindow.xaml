<Window x:Class="Carpooling.UI.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація - Carpooling" Height="640" Width="450" 
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2196F3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="text" 
                                   Text="{TemplateBinding Content}" 
                                   Background="Transparent"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="text" Property="Foreground" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30,20,30,20">
            <StackPanel>
                <TextBlock Text="Створення акаунта" FontSize="26" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#333"/>

                <TextBlock Text="Прізвище та ім'я:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFullName" Height="34" Margin="0,0,0,10" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Логін:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLogin" Height="34" Margin="0,0,0,10" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Номер телефону (+380...):" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPhone" Height="34" Margin="0,0,0,10" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Оберіть роль:" Foreground="#555" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbRole" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Пасажир" IsSelected="True"/>
                    <ComboBoxItem Content="Водій"/>
                </ComboBox>

                <TextBlock Text="Пароль:" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="34" Margin="0,0,0,10" VerticalContentAlignment="Center" Padding="8,0"/>

                <TextBlock Text="Підтвердження пароля:" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtConfirmPassword" Height="34" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="8,0"/>

                <Button Content="Зареєструватися" Height="45" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="btnRegister_Click"/>

                <Grid Margin="0,15,0,10">
                    <Separator VerticalAlignment="Center" Foreground="#DDD"/>
                    <TextBlock Text="або" HorizontalAlignment="Center" Background="#F5F5F5" 
                               Padding="10,0" Foreground="#AAA" FontSize="11"/>
                </Grid>

                <Button Content="Вже є акаунт? Увійти" 
                        Style="{StaticResource LinkButtonStyle}"
                        Cursor="Hand" Click="btnBackToLogin_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>