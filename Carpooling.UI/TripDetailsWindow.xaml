<Window x:Class="Carpooling.UI.TripDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Деталі поїздки" Height="500" Width="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#007ACC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="btnBack" Content="← Назад" Click="btnBack_Click" Style="{StaticResource TextButtonStyle}"/>
            <TextBlock Text="Деталі поїздки" FontSize="20" FontWeight="Bold" Margin="50,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="lblRoute" FontSize="18" FontWeight="SemiBold" Text="Львів → Київ" Margin="0,0,0,5"/>
                <TextBlock x:Name="lblDate" Text="Дата: 15.05.2026 10:00" Foreground="Gray" Margin="0,0,0,10"/>

                <Separator Margin="0,10"/>

                <TextBlock Text="Водій та автомобіль" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="lblDriver" Text="Водій: Олександр" Margin="0,0,0,2"/>
                <TextBlock x:Name="lblCar" Text="Авто: Tesla Model 3 (AA 1234 BB)" Margin="0,0,0,10"/>

                <Separator Margin="0,10"/>

                <TextBlock Text="Додаткова інформація" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="lblSeats" Text="Вільних місць: 3 з 4" Margin="0,0,0,2"/>
                <TextBlock x:Name="lblPrice" Text="Ціна: 450 грн" FontSize="16" Foreground="Green" Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" x:Name="btnBook" Content="Забронювати місце" 
                Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold"
                Click="btnBook_Click" Margin="0,10,0,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>